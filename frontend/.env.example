
# (mock mode removed: use `npm run dev:memory` in ../backend for a no-install backend)

# API base path. Leave as /api/v1 in dev (Vite proxies it to the backend).
# In production, set to the absolute URL if the API is on another origin,
# e.g. https://identity.example.com/api/v1 (and add the dashboard origin to
# CORS_ORIGINS on the backend).
VITE_API_BASE_URL=/api/v1
