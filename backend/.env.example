# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4100
# Comma-separated origins allowed to call the API from a browser (the dashboard).
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=saas_identity
PGUSER=saas_app
PGPASSWORD=change-me
# true in production when the DB requires TLS
PGSSL=false
PG_POOL_MAX=20

# ---------------------------------------------------------------------------
# EMS (Laravel HRMS) -> SaaS webhook
# Must equal SAAS_WEBHOOK_SECRET in the HRMS .env. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
EMS_WEBHOOK_SECRET=
# Reject signed requests older than this many seconds (replay protection).
EMS_WEBHOOK_TOLERANCE_SECONDS=300

# ---------------------------------------------------------------------------
# JWT (RS256). Run `npm run keys:generate` to create keys/ and fill these in.
# ---------------------------------------------------------------------------
JWT_ISSUER=https://identity.example.com
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_KEY_ID=identity-key-1
# Portal tokens are short-lived on purpose: revocation latency <= this TTL even
# if a portal ignores webhooks and never calls /auth/introspect.
PORTAL_TOKEN_TTL_SECONDS=900
ADMIN_TOKEN_TTL_SECONDS=28800

# ---------------------------------------------------------------------------
# Outgoing target-portal webhooks (outbox dispatcher)
# ---------------------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=3000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_HTTP_TIMEOUT_MS=10000

# Containers: instead of key files, paste the PEM text (newlines as \n).
# These win over JWT_PRIVATE_KEY_PATH / JWT_PUBLIC_KEY_PATH.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
